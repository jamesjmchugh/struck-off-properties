# App Authentication
# Staff email and password for login
STAFF_EMAIL=james@wildboarcreek.com
STAFF_PASSWORD=changeme123

# Resend Email Settings
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM=james@wildboarcreek.com

# Send Limits
SEND_DAILY_CAP=5

# Follow-up Auto-send
# Set to true to automatically send 90-day follow-ups (default: false)
FOLLOWUP_AUTOSEND=false

# Inbound Webhook Secret
# Shared secret for authenticating inbound email webhooks
WEBHOOK_SECRET=your-webhook-secret-here

# App Settings
PORT=3000
NODE_ENV=development
SESSION_SECRET=texas-crm-secret-key-change-in-production
